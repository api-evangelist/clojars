        {
          "id": "dde9086b-4834-4a81-bbfe-65af3243ffa6",
          "name": "Get Release Feed",
          "request": {
            "name": "Get Release Feed",
            "description": {
              "content": "Returns a paginated feed of releases after a given timestamp. Returns up to 500 releases per page. Paginate using the next_from timestamp from the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "release-feed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp to start the feed from (e.g. 2024-01-01T00:00:00Z)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "27ca1cf6-3e13-4bac-b961-07e43f9a1873",
              "name": "Paginated list of releases.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "release-feed"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "from",
                      "value": "2024-01-01T00:00:00Z"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"releases\": [\n    {\n      \"group_name\": \"ring\",\n      \"jar_name\": \"ring-core\",\n      \"version\": \"1.11.0\",\n      \"created\": \"2024-01-15T09:23:00Z\",\n      \"description\": \"Core Ring library\"\n    },\n    {\n      \"group_name\": \"ring\",\n      \"jar_name\": \"ring-core\",\n      \"version\": \"1.11.0\",\n      \"created\": \"2024-01-15T09:23:00Z\",\n      \"description\": \"Core Ring library\"\n    }\n  ],\n  \"next_from\": \"2024-02-01T12:00:00Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
